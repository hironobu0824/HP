---
import { SITE_NAME } from "../../data/links";
import Layout from "../../layouts/Layout.astro";
import {
  currentMonth,
  formatDateTime,
  formatMonth,
  isAllowedMonth,
  shiftMonth,
} from "../../lib/date";
import { loadSchedule } from "../../lib/schedule";

export const prerender = false;

const now = new Date();
const month = Astro.url.searchParams.get("month") ?? currentMonth(now);
if (!isAllowedMonth(month, now)) {
  return new Response("指定できるのは当月の前後 12 か月です。", { status: 400 });
}

const result = await loadSchedule({ month });
const monthLabel = formatMonth(month);
const previous = shiftMonth(month, -1);
const next = shiftMonth(month, 1);
const events = result.status === "ok" ? result.events : [];
---

<Layout title={`${monthLabel} 告知画像`} noindex>
  <div class="mx-auto max-w-3xl px-4 pt-10 md:px-8">
    <h1 class="text-2xl font-bold">{monthLabel} の告知画像</h1>
    <nav class="mt-3 flex gap-4 text-sm" aria-label="月の切り替え">
      {
        isAllowedMonth(previous, now) && (
          <a href={`?month=${previous}`} class="text-accent underline">
            {formatMonth(previous)}
          </a>
        )
      }
      {
        isAllowedMonth(next, now) && (
          <a href={`?month=${next}`} class="text-accent underline">
            {formatMonth(next)}
          </a>
        )
      }
    </nav>

    {
      result.status === "error" && (
        <p class="mt-6 rounded-sm border border-line bg-surface p-4 text-sm">
          予定を取得できませんでした。時間をおいて開き直してください。
        </p>
      )
    }
    {
      result.status === "ok" && (
        <p class="mt-4 text-sm text-muted">
          予定の取得: {formatDateTime(result.fetchedAt)}
          。カレンダーの変更は最長 10 分後に反映されます。
          {result.stale && "最新でない可能性があります。"}
        </p>
      )
    }
    {
      result.status === "ok" && events.length === 0 && (
        <p class="mt-6 text-sm">この月の公開中の予定はありません。</p>
      )
    }

    {
      events.length > 0 && (
        <poster-maker
          class="mt-6 block"
          data-events={JSON.stringify(events)}
          data-month-label={monthLabel}
          data-name={SITE_NAME}
          data-url={Astro.url.host}
        >
          <button
            type="button"
            disabled
            data-save
            class="rounded-sm bg-accent px-6 py-3 font-bold text-white disabled:opacity-50"
          >
            画像を準備しています
          </button>
          <p data-status class="mt-2 text-sm text-muted" role="status" />
          <div data-pages class="mt-6 flex flex-col gap-6" />
        </poster-maker>
      )
    }
  </div>
</Layout>

<script>
  import type { LiveEvent } from "../../lib/calendar";
  import {
    allPosterText,
    canvasMeasure,
    drawPoster,
    loadPosterFonts,
    paginate,
    POSTER_HEIGHT,
    POSTER_WIDTH,
  } from "../../lib/poster";

  function toBlob(canvas: HTMLCanvasElement): Promise<Blob> {
    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error("toBlob failed"))), "image/png");
    });
  }

  class PosterMaker extends HTMLElement {
    async connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>("[data-save]");
      const status = this.querySelector<HTMLElement>("[data-status]");
      const container = this.querySelector<HTMLElement>("[data-pages]");
      if (!button || !status || !container) return;

      const { events: rawEvents, monthLabel, name, url } = this.dataset;
      const events = JSON.parse(rawEvents ?? "[]") as LiveEvent[];
      const options = { name: name ?? "", monthLabel: monthLabel ?? "", url: url ?? "" };

      try {
        await loadPosterFonts(allPosterText(events, options.monthLabel, options.name, options.url));

        const measureContext = document.createElement("canvas").getContext("2d");
        if (!measureContext) throw new Error("canvas is not available");
        const pages = paginate(events, canvasMeasure(measureContext));

        const files = await Promise.all(
          pages.map(async (rows, index) => {
            const canvas = document.createElement("canvas");
            canvas.width = POSTER_WIDTH;
            canvas.height = POSTER_HEIGHT;
            canvas.className = "h-auto w-full rounded-sm border border-line";
            canvas.setAttribute("role", "img");
            canvas.setAttribute("aria-label", `${options.monthLabel} ライブ日程 ${index + 1}枚目`);
            const ctx = canvas.getContext("2d");
            if (!ctx) throw new Error("canvas is not available");
            drawPoster(ctx, rows, { ...options, pageNumber: index + 1, pageCount: pages.length });
            container.appendChild(canvas);

            const suffix = pages.length > 1 ? `-${index + 1}` : "";
            return new File([await toBlob(canvas)], `${options.name}${options.monthLabel}ライブ日程${suffix}.png`, {
              type: "image/png",
            });
          }),
        );

        button.textContent = files.length > 1 ? `画像 ${files.length} 枚を保存` : "画像を保存";
        button.disabled = false;
        button.addEventListener("click", () => void save(files, status));
      } catch (error) {
        console.error("Failed to create the poster", error);
        button.textContent = "画像を作成できませんでした";
        status.textContent = "時間をおいて開き直すか、別のブラウザでお試しください。";
      }
    }
  }

  async function save(files: File[], status: HTMLElement) {
    status.textContent = "";
    // スマートフォンでは共有シートから写真に保存できる
    if (navigator.canShare?.({ files })) {
      try {
        await navigator.share({ files });
        return;
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        console.error("Failed to share the poster", error);
      }
    }
    for (const file of files) {
      const link = document.createElement("a");
      link.href = URL.createObjectURL(file);
      link.download = file.name;
      link.click();
      setTimeout(() => URL.revokeObjectURL(link.href), 10_000);
    }
    status.textContent = "画像を保存しました。";
  }

  if (!customElements.get("poster-maker")) {
    customElements.define("poster-maker", PosterMaker);
  }
</script>
