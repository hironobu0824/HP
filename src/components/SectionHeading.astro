---
type Props = {
  en: string;
  ja: string;
  as?: "h1" | "h2";
};

const { en, ja, as: Tag = "h2" } = Astro.props;
---

<Tag class="flex flex-col gap-1">
  <span class="text-xs font-semibold tracking-[0.3em] text-muted md:text-sm">{en}</span>
  <span class="text-2xl font-bold text-accent md:text-3xl">{ja}</span>
</Tag>
