---
type Props = {
  items: { label: string; value: string }[];
};

const { items } = Astro.props;
---

<dl class="mt-4 border-t border-line bg-surface">
  {
    items.map((item) => (
      <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-3 border-b border-line p-3 text-sm md:grid-cols-[4rem_1fr]">
        <dt class="font-semibold text-muted md:text-xs md:font-normal">{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))
  }
</dl>
